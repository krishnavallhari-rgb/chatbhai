{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatbhai",
  "compatibility_date": "2026-07-27",
  "main": "artifacts/social-chat/dist/public",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "artifacts/social-chat/dist/public",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
